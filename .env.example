# For local development. SQLite is used if DATABASE_URL is omitted.
DATABASE_URL=sqlite:///./fasalsense.db
SECRET_KEY=replace-with-a-long-random-secret
DEMO_MODE=true
# Chharoli Budruk, Pune (approximate center; verify the exact project boundary in Google Maps)
CHHAROLI_LAT=18.637
CHHAROLI_LON=73.881

# true = use labelled synthetic crop supply/demand signals when platform activity is incomplete
MARKET_DEMO_MODE=true
